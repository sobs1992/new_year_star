# ESP32-C5HR8: 8MB flash, 8MB embedded PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
# Skip PSRAM test at boot (~1.8 s)
# CONFIG_SPIRAM_MEMTEST is not set
# Own partition table: 2.5MB app + LittleFS partition with the tracks
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Console on USB-Serial-JTAG only: frees UART0 pins GPIO11/GPIO12 (D6/D7)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Captive portal, DLNA (SSDP + events), AirPlay (RTSP + 3 UDP), mDNS, many phone connections
CONFIG_LWIP_MAX_SOCKETS=32
# Wi-Fi/LWIP and TLS buffers in PSRAM: web radio over HTTPS needs a lot of RAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# DLNA control points send long headers (SOAPACTION, CALLBACK, user agents)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# Internal RAM is tight with Wi-Fi + TLS + DLNA + AirPlay: only small allocations stay internal
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Spotify Connect (cspot) is C++ and reports network errors with exceptions
CONFIG_COMPILER_CXX_EXCEPTIONS=y
# Decoders the player uses: MP3, AAC, FLAC, WAV (PCM / ADPCM), M4A (AAC / ALAC), ALAC for
# AirPlay. The rest only took flash space (Spotify brings its own Vorbis decoder).
# CONFIG_AUDIO_DECODER_G711_SUPPORT is not set
# CONFIG_AUDIO_DECODER_AMRNB_SUPPORT is not set
# CONFIG_AUDIO_DECODER_AMRWB_SUPPORT is not set
# CONFIG_AUDIO_DECODER_OPUS_SUPPORT is not set
# CONFIG_AUDIO_DECODER_VORBIS_SUPPORT is not set
# CONFIG_AUDIO_DECODER_SBC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_LC3_SUPPORT is not set
# CONFIG_AUDIO_DECODER_G722_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT is not set
# .bss of Wi-Fi, lwip, libstdc++ and cspot in PSRAM: frees ~25 KB of internal RAM for DMA
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
